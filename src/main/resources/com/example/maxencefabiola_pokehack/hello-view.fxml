<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.maxencefabiola_pokehack.controller.PokedexController"
            stylesheets="@pokedex.css"
            prefWidth="1000"
            prefHeight="700">

    <top>
        <VBox spacing="14" alignment="CENTER">
            <padding>
                <Insets top="25" bottom="20" left="20" right="20"/>
            </padding>

            <Label text="Pokédex"
                   styleClass="title-label"/>

            <HBox spacing="14" alignment="CENTER">
                <TextField fx:id="searchField"
                           styleClass="search-field"
                           promptText="Nom ou ID du Pokémon..."
                           prefWidth="380"/>

                <Button text="Rechercher"
                        styleClass="search-button"
                        onAction="#searchPokemon"/>
            </HBox>

            <Label fx:id="messageLabel"
                   text=""
                   styleClass="message-label"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="45" alignment="CENTER">
            <padding>
                <Insets top="15" bottom="30" left="40" right="40"/>
            </padding>

            <VBox spacing="14"
                  alignment="CENTER"
                  prefWidth="300"
                  prefHeight="470"
                  styleClass="info-card">

                <ImageView fx:id="pokemonImage"
                           fitWidth="190"
                           fitHeight="190"
                           preserveRatio="true"/>

                <Label fx:id="nameLabel"
                       text="Nom"
                       styleClass="pokemon-name"/>

                <Label fx:id="idLabel"
                       text="ID : ---"
                       styleClass="info-label"/>

                <Label fx:id="typeLabel"
                       text="Type : ---"
                       styleClass="info-label"/>

                <Label fx:id="heightLabel"
                       text="Taille : ---"
                       styleClass="info-label"/>

                <Label fx:id="weightLabel"
                       text="Poids : ---"
                       styleClass="info-label"/>


                <Button fx:id="captureButton"
                        text="Capturer"
                        styleClass="capture-button"
                        onAction="#capturePokemon"/>



                <Button fx:id="deleteButton"
                        text="Supprimer"
                        styleClass="delete-button"
                        onAction="#deletePokemon"/>


            </VBox>

            <VBox spacing="14"
                  prefWidth="430"
                  prefHeight="470"
                  styleClass="list-card">

                <Label text="Pokémon capturés"
                       styleClass="section-title"/>

                <ListView fx:id="pokemonList"
                          prefHeight="370"
                          styleClass="pokemon-list"/>

                <Label fx:id="counterLabel"
                       text="0 Pokémon capturé"
                       styleClass="counter-label"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>
