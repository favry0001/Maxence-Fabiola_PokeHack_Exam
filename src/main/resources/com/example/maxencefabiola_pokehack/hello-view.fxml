<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.maxencefabiola_pokehack.controller.PokedexController"
            stylesheets="@pokedex.css"
            prefWidth="850"
            prefHeight="650">

    <top>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>

            <Label text="Pokédex"
                   styleClass="title-label"/>

            <HBox spacing="10" alignment="CENTER">

                <TextField fx:id="searchField"
                           promptText="Nom ou ID du Pokémon..."
                           prefWidth="300"
                           styleClass="search-field"/>

                <Button text="Rechercher"
                        prefWidth="120"
                        styleClass="search-button"
                        onAction="#searchPokemon"/>

            </HBox>

            <Label fx:id="messageLabel"
                   text=""
                   styleClass="message-label"/>

        </VBox>
    </top>

    <center>

        <HBox spacing="60" alignment="CENTER">

            <VBox spacing="12" alignment="CENTER" styleClass="info-card">

                <ImageView fx:id="pokemonImage"
                           fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true"/>

                <Label fx:id="nameLabel"
                       text="Nom"
                       styleClass="pokemon-name"/>

                <Label fx:id="idLabel"
                       text="ID : ---"
                       styleClass="info-label"/>

                <Label fx:id="typeLabel"
                       text="Type : ---"
                       styleClass="info-label"/>

                <Label fx:id="heightLabel"
                       text="Taille : ---"
                       styleClass="info-label"/>

                <Label fx:id="weightLabel"
                       text="Poids : ---"
                       styleClass="info-label"/>

                <Button fx:id="deleteButton"
                        text="Supprimer"
                        styleClass="delete-button"/>

            </VBox>

            <VBox spacing="10" styleClass="list-card">

                <Label text="Pokémon capturés"
                       styleClass="section-title"/>

                <ListView fx:id="pokemonList"
                          prefWidth="300"
                          prefHeight="350"/>

                <Label fx:id="counterLabel"
                       text="0 Pokémon capturé"
                       styleClass="info-label"/>

            </VBox>

        </HBox>

    </center>

</BorderPane>